{
  "compilerOptions": {
    "target": "ES2022", "lib": ["ES2022"], "module": "ESNext",
    "moduleResolution": "Bundler", "jsx": "react-jsx", "strict": true,
    "skipLibCheck": true, "noEmit": true, "types": ["node", "react"]
  },
  "include": ["index.*", "client/**/*.ts", "client/**/*.tsx", "server/**/*.ts", "shared/**/*.ts"]
}
